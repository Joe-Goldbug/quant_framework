  "expected_polarity": -1,
  "stage0_op_count": 3,
  "core_fields": [
    "negative_score_maximum_value",
    "negative_score_median_value_3",
    "negative_score_average_value"
  ],
  "max_ast_operators": 8,
  "max_champion_operators": 6,
  "is_golden_shot": false,
  "items": [
    {
      "slot": 1,
      "optimize_reason": "Polarity-corrected core (flip subtract to short high-tail negative-sentiment stocks, resolving is_polarity_inverted). Replace parent's high-turnover ts_scale with exponential half-life decay (d=10, factor=0.8) to compress turnover from 75% toward the 15-35% band. group_neutralize retains cardinal magnitude (Iron Law B) and lowers ProdCorr vs rank-based parent.",
      "expression": "group_neutralize(ts_decay_exp_window(divide(subtract(negative_score_median_value_3, negative_score_maximum_value), add(negative_score_average_value, 1)), 10, 0.8), subindustry)",
      "neutralization": "SUBINDUSTRY",
      "type": "exploit",
      "original_alpha": "group_rank(ts_scale(divide(subtract(negative_score_maximum_value, negative_score_median_value_3), add(negative_score_average_value, 1)), 20), subindustry)"
    },
    {
      "slot": 2,
      "optimize_reason": "Paired horizon probe (2N=20) of slot 1: same polarity-corrected core and group_neutralize(subindustry) skeleton, longer exponential decay window. Validates parameter plateau (stable Sharpe across 10/20) to reject spike overfitting and confirm durable low-turnover signal.",
      "expression": "group_neutralize(ts_decay_exp_window(divide(subtract(negative_score_median_value_3, negative_score_maximum_value), add(negative_score_average_value, 1)), 20, 0.8), subindustry)",
      "neutralization": "SUBINDUSTRY",
      "type": "exploit",
      "original_alpha": "group_rank(ts_scale(divide(subtract(negative_score_maximum_value, negative_score_median_value_3), add(negative_score_average_value, 1)), 20), subindustry)"
    },
    {
      "slot": 3,
      "optimize_reason": "Same decay smoothing skeleton as slot 1 but neutralized at INDUSTRY level instead of subindustry. Industry-level residual retains broader cross-sectional comparison, improving magnitude stability and reducing overfitting to fine-grained subindustry noise while keeping turnover low.",
      "expression": "group_neutralize(ts_decay_exp_window(divide(subtract(negative_score_median_value_3, negative_score_maximum_value), add(negative_score_average_value, 1)), 10, 0.8), industry)",
      "neutralization": "INDUSTRY",
      "type": "exploit",
      "original_alpha": "group_rank(ts_scale(divide(subtract(negative_score_maximum_value, negative_score_median_value_3), add(negative_score_average_value, 1)), 20), subindustry)"
    },
    {
      "slot": 4,
      "optimize_reason": "Paired horizon probe (2N=20) of slot 3 at INDUSTRY grouping. Confirms the low-turnover negative-tail signal is robust to window doubling and grouping choice, a prerequisite for ALL-PASS stability.",
      "expression": "group_neutralize(ts_decay_exp_window(divide(subtract(negative_score_median_value_3, negative_score_maximum_value), add(negative_score_average_value, 1)), 20, 0.8), industry)",
      "neutralization": "INDUSTRY",
      "type": "exploit",
      "original_alpha": "group_rank(ts_scale(divide(subtract(negative_score_maximum_value, negative_score_median_value_3), add(negative_score_average_value, 1)), 20), subindustry)"
    },
    {
      "slot": 5,
      "optimize_reason": "EXPERIMENT (regional_or_sharpe_deficit fix): apply group_neutralize at MARKET (global) level so the negative-tail spread is residualized against the entire global cross-section. Global normalization removes region-specific mean biases that caused LOW_GLB_AMER/EMEA_SHARPE, making the bet consistent across GLB regions. Low-turnover decay retained.",
      "expression": "group_neutralize(ts_decay_exp_window(divide(subtract(negative_score_median_value_3, negative_score_maximum_value), add(negative_score_average_value, 1)), 10, 0.8), market)",
      "neutralization": "MARKET",
      "type": "explore",
      "original_alpha": "group_rank(ts_scale(divide(subtract(negative_score_maximum_value, negative_score_median_value_3), add(negative_score_average_value, 1)), 20), subindustry)"
    },
